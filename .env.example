# Megathon 2026 — Multi-Modal Drone Detection Platform
# Copy to .env and adjust as needed

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# RF Model
RF_MODEL_PATH=models/
RF_THRESHOLD=0.75

# Radar Mode: "simulation" or "hardware"
RADAR_MODE=simulation

# Vision Mode: "not_configured" or "simulation"
VISION_MODE=not_configured

# Demo Mode
DEMO_MODE=true
